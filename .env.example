# .env.example
# Copy this file to .env and update values for your local environment.
# Linux/macOS: cp .env.example .env
# Windows PowerShell: Copy-Item .env.example .env

# JWT
JWT_SECRET_KEY=your-very-strong-secret-key-change-this
JWT_EXPIRE_MINUTES_USER=60
JWT_EXPIRE_MINUTES_ADMIN=30

# Internal service-to-service secret
INTERNAL_API_SECRET=your-internal-api-secret-change-this

# Admin account
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=adminadmin1234
ADMIN_USERNAME=admin

# Database passwords
USER_DB_PASSWORD=user_db_password
PRODUCT_DB_PASSWORD=product_db_password
ORDER_DB_PASSWORD=order_db_password
INVENTORY_DB_PASSWORD=inventory_db_password
PAYMENT_DB_PASSWORD=payment_db_password

# Optional DB users (default: user)
# USER_DB_USER=user
# PRODUCT_DB_USER=user
# ORDER_DB_USER=user
# INVENTORY_DB_USER=user
# PAYMENT_DB_USER=user

# Payment mock success rate (0.0 ~ 1.0)
PAYMENT_SUCCESS_RATE=1.0

# Service URLs (optional override)
INVENTORY_SERVICE_URL=http://inventory-service:8000

# Kafka
KAFKA_TOPIC_PAYMENT_CREATED=payment-created
KAFKA_GROUP_ID_PAYMENT_EVENTS=payment-event-service

# Payment event DB
PAYMENT_EVENT_DB_PASSWORD=payment_event_db_password
# PAYMENT_EVENT_DB_USER=user
